#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run console check before pushing
npm run check:console || { echo 'check-console failed — aborting push'; exit 1; }

# Run only unit tests (exclude integration/RLS tests that need local Supabase)
npx vitest run --exclude 'tests/rls/**' --exclude 'tests/concurrency/**' --silent 2>/dev/null || { echo 'Unit tests failed — aborting push'; exit 1; }
