#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Verify no console.* in server files (security/quality check)
npm run check:console || { echo 'check-console failed — aborting push'; exit 1; }

# Verify TypeScript compiles without errors
npx tsc --noEmit --quiet 2>/dev/null || { echo 'TypeScript compilation failed — aborting push'; exit 1; }
