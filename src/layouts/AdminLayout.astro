---
/**
 * AdminLayout - Panel de administración
 * Sidebar con navegación y área de contenido
 * Incluye verificación de autenticación como segunda capa de defensa
 */
import BaseLayout from './BaseLayout.astro';
import { supabase, supabaseAdmin } from '@lib/supabase';

interface Props {
  title: string;
}

// === SEGUNDA CAPA DE SEGURIDAD (defensa en profundidad) ===
// El middleware ya protege, pero si por algún motivo falla,
// esta verificación impide que se renderice contenido admin.
try {
  const token = Astro.cookies.get('sb-access-token')?.value;
  if (!token) {
    return Astro.redirect('/admin/login');
  }
  const { data: { user }, error: authError } = await supabase.auth.getUser(token);
  if (!user || authError) {
    return Astro.redirect('/admin/login');
  }
  const { data: adminUser } = await supabaseAdmin
    .from('admin_users')
    .select('id, is_active')
    .eq('auth_user_id', user.id)
    .eq('is_active', true)
    .single();
  if (!adminUser) {
    return Astro.redirect('/admin/login');
  }
} catch (e) {
  console.error('[AdminLayout] Auth check failed:', e);
  return Astro.redirect('/admin/login');
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'home' },
  { href: '/admin/productos', label: 'Productos', icon: 'box' },
  { href: '/admin/inventario', label: 'Inventario', icon: 'package' },
  { href: '/admin/pedidos', label: 'Pedidos', icon: 'shopping-bag' },
  { href: '/admin/devoluciones', label: 'Devoluciones', icon: 'undo-2' },
  { href: '/admin/categorias', label: 'Categorías', icon: 'folder' },
  { href: '/admin/settings', label: 'Configuración', icon: 'settings' },
];
---

<BaseLayout title={title}>
  <div class="min-h-screen bg-primary-100 flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-primary-900 text-white fixed inset-y-0 left-0 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300" id="admin-sidebar">
      <div class="flex items-center justify-between h-16 px-4 border-b border-primary-800">
        <a href="/admin" class="font-display text-lg tracking-widest uppercase">Admin</a>
        <button class="lg:hidden p-2" id="close-sidebar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <nav class="p-4 space-y-1">
        {navItems.map(item => (
          <a 
            href={item.href}
            class={`flex items-center gap-3 px-4 py-3 rounded-lg text-sm transition-colors ${
              currentPath === item.href 
                ? 'bg-white text-primary-900 font-medium' 
                : 'text-primary-300 hover:bg-primary-800 hover:text-white'
            }`}
          >
            {item.icon === 'home' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
            {item.icon === 'box' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            )}
            {item.icon === 'package' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 22V12" />
              </svg>
            )}
            {item.icon === 'shopping-bag' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            )}
            {item.icon === 'undo-2' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" />
              </svg>
            )}
            {item.icon === 'folder' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
              </svg>
            )}
            {item.icon === 'settings' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {item.label}
          </a>
        ))}
      </nav>
      
      <!-- Logout -->
      <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-primary-800">
        <a href="/api/auth/logout?type=admin" class="flex items-center gap-3 w-full px-4 py-3 text-sm text-primary-400 hover:text-white hover:bg-primary-800 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Cerrar sesión
        </a>
      </div>
    </aside>
    
    <!-- Overlay for mobile -->
    <div class="fixed inset-0 bg-black/50 z-20 hidden lg:hidden" id="sidebar-overlay"></div>
    
    <!-- Main Content -->
    <main class="flex-1 lg:ml-64">
      <!-- Top Bar -->
      <header class="h-16 bg-white border-b border-primary-200 flex items-center justify-between px-4 lg:px-8 sticky top-0 z-10">
        <div class="flex items-center gap-4">
          <button class="lg:hidden p-2" id="open-sidebar">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 class="font-display text-xl">{title}</h1>
        </div>
        
        <div class="flex items-center gap-4">
          <!-- Notification Bell -->
          <div class="relative" id="notif-container">
            <button id="notif-bell" class="relative p-2 text-primary-500 hover:text-primary-900 transition-colors" title="Alertas de stock">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
              </svg>
              <span id="notif-badge" class="hidden absolute -top-0.5 -right-0.5 bg-red-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
            </button>
            <!-- Dropdown -->
            <div id="notif-dropdown" class="hidden absolute right-0 top-full mt-2 w-80 bg-white border border-primary-200 rounded-lg shadow-xl z-50 max-h-96 overflow-y-auto">
              <div class="p-3 border-b border-primary-200 flex items-center justify-between">
                <h3 class="font-medium text-sm">Alertas de Stock</h3>
                <a href="/admin/inventario?filter=out" class="text-xs text-primary-500 hover:text-primary-900">Ver todo</a>
              </div>
              <div id="notif-list" class="divide-y divide-primary-100">
                <div class="p-4 text-center text-primary-400 text-sm">Cargando...</div>
              </div>
            </div>
          </div>
          <a href="/" class="px-3 py-2 text-xs tracking-widest uppercase font-medium rounded-full bg-primary-900 text-white hover:bg-primary-800 transition-all" title="Ir a la tienda">Tienda</a>
          <span class="text-sm text-primary-500">Admin</span>
        </div>
      </header>
      
      <!-- Page Content -->
      <div class="p-4 lg:p-8">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  const sidebar = document.getElementById('admin-sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const openBtn = document.getElementById('open-sidebar');
  const closeBtn = document.getElementById('close-sidebar');
  
  function openSidebar() {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
  }
  
  function closeSidebar() {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
  }
  
  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // Notification Bell - Stock Alerts
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  const bellBtn = document.getElementById('notif-bell');
  const dropdown = document.getElementById('notif-dropdown');
  const badge = document.getElementById('notif-badge');
  const notifList = document.getElementById('notif-list');
  let notifOpen = false;

  // Toggle dropdown
  bellBtn?.addEventListener('click', () => {
    notifOpen = !notifOpen;
    dropdown?.classList.toggle('hidden', !notifOpen);
    if (notifOpen) loadAlerts();
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    const container = document.getElementById('notif-container');
    if (notifOpen && container && !container.contains(e.target as Node)) {
      notifOpen = false;
      dropdown?.classList.add('hidden');
    }
  });

  // Load alert count (badge)
  async function loadAlertCount() {
    try {
      const res = await fetch('/api/admin/stock/alerts?summary=true');
      if (!res.ok) return;
      const data = await res.json();
      const count = data.total_alerts || 0;
      if (badge) {
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : String(count);
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
    } catch {}
  }

  // Load alerts list
  async function loadAlerts() {
    if (!notifList) return;
    notifList.innerHTML = '<div class="p-4 text-center text-primary-400 text-sm">Cargando...</div>';
    try {
      const res = await fetch('/api/admin/stock/alerts?limit=10');
      if (!res.ok) throw new Error();
      const data = await res.json();
      const variants = data.variants || [];

      if (variants.length === 0) {
        notifList.innerHTML = '<div class="p-6 text-center"><svg class="w-8 h-8 mx-auto mb-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg><p class="text-sm text-green-600 font-medium">Todo el stock está en orden</p></div>';
        return;
      }

      notifList.innerHTML = variants.map((v: any) => {
        const isOut = v.stock === 0;
        const icon = isOut
          ? '<span class="w-2 h-2 rounded-full bg-red-500 flex-shrink-0"></span>'
          : '<span class="w-2 h-2 rounded-full bg-amber-500 flex-shrink-0"></span>';
        const label = isOut ? 'Agotado' : `${v.stock} uds`;
        const labelClass = isOut ? 'text-red-600 font-bold' : 'text-amber-600 font-medium';
        return `
          <div class="px-3 py-2.5 hover:bg-primary-50 flex items-center gap-3 text-sm">
            ${icon}
            <div class="flex-1 min-w-0">
              <p class="font-medium truncate">${v.product?.name || 'Producto'}</p>
              <p class="text-xs text-primary-400">${v.size} / ${v.color}</p>
            </div>
            <span class="${labelClass} text-xs whitespace-nowrap">${label}</span>
          </div>
        `;
      }).join('');

      // Footer
      notifList.innerHTML += `
        <a href="/admin/inventario" class="block p-3 text-center text-xs font-medium text-primary-600 hover:bg-primary-50 border-t border-primary-200">
          Ver inventario completo →
        </a>
      `;
    } catch {
      notifList.innerHTML = '<div class="p-4 text-center text-red-500 text-sm">Error al cargar alertas</div>';
    }
  }

  // Initial load + auto-refresh every 60s
  loadAlertCount();
  setInterval(loadAlertCount, 60000);
</script>
