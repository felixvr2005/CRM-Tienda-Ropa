---
/**
 * Contacto Page
 * Formulario de contacto y información
 */
import PublicLayout from '@layouts/PublicLayout.astro';

export const prerender = false;
---

<PublicLayout title="Contacto | Essential Force">
  <div class="max-w-7xl mx-auto px-4 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-primary-500 mb-8">
      <a href="/" class="hover:text-primary-900">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-primary-900">Contacto</span>
    </nav>
    
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="font-display text-4xl md:text-5xl mb-4">CONTACTO</h1>
      <p class="text-primary-600 max-w-2xl mx-auto">
        ¿Tienes alguna pregunta? Estamos aquí para ayudarte.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div class="bg-white p-8 border border-primary-200">
        <h2 class="font-display text-2xl mb-6">Envíanos un mensaje</h2>
        
        <form id="contact-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-primary-700 mb-2">
                Nombre *
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-primary-700 mb-2">
                Email *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors"
                placeholder="tu@email.com"
              />
            </div>
          </div>
          
          <div>
            <label for="phone" class="block text-sm font-medium text-primary-700 mb-2">
              Teléfono
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone"
              class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors"
              placeholder="+34 600 000 000"
              pattern="[\+]?[0-9\s\-]{6,20}"
              inputmode="tel"
              title="Solo números, espacios, guiones y opcionalmente + al inicio"
            />
          </div>
          
          <div>
            <label for="subject" class="block text-sm font-medium text-primary-700 mb-2">
              Asunto *
            </label>
            <select 
              id="subject" 
              name="subject" 
              required
              class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors bg-white"
            >
              <option value="">Selecciona un asunto</option>
              <option value="pedido">Consulta sobre mi pedido</option>
              <option value="producto">Información de producto</option>
              <option value="devolucion">Devoluciones y cambios</option>
              <option value="otro">Otro</option>
            </select>
          </div>
          
          <div>
            <label for="order-number" class="block text-sm font-medium text-primary-700 mb-2">
              Número de pedido (si aplica)
            </label>
            <input 
              type="text" 
              id="order-number" 
              name="order_number"
              class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors"
              placeholder="FS-XXXXX"
            />
          </div>
          
          <div>
            <label for="message" class="block text-sm font-medium text-primary-700 mb-2">
              Mensaje *
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required
              class="w-full px-4 py-3 border border-primary-300 focus:border-primary-900 focus:outline-none transition-colors resize-none"
              placeholder="¿En qué podemos ayudarte?"
            ></textarea>
          </div>
          
          <div class="flex items-start gap-3">
            <input 
              type="checkbox" 
              id="privacy" 
              name="privacy" 
              required
              class="mt-1"
            />
            <label for="privacy" class="text-sm text-primary-600">
              Acepto la <a href="/privacidad" class="underline hover:text-primary-900">política de privacidad</a> y el tratamiento de mis datos personales.
            </label>
          </div>
          
          <button 
            type="submit"
            class="w-full bg-primary-900 text-white py-4 font-medium hover:bg-primary-800 transition-colors"
          >
            ENVIAR MENSAJE
          </button>
          
          <div id="form-message" class="hidden text-center py-3"></div>
        </form>
      </div>
      
      <!-- Contact Info -->
      <div class="space-y-8">
        <!-- Info Cards -->
        <div class="bg-primary-50 p-8">
          <h2 class="font-display text-2xl mb-6">Información de contacto</h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-900 text-white flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium mb-1">Email</h3>
                <p class="text-primary-600">hola@essentialforce.com</p>
                <p class="text-sm text-primary-500 mt-1">Respondemos en 24-48h</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-900 text-white flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium mb-1">Teléfono</h3>
                <p class="text-primary-600">+34 900 123 456</p>
                <p class="text-sm text-primary-500 mt-1">Lun - Vie: 9:00 - 18:00</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-900 text-white flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium mb-1">Dirección</h3>
                <p class="text-primary-600">
                  Calle de la Moda, 123<br>
                  28001 Madrid, España
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- FAQ -->
        <div class="bg-white border border-primary-200 p-8">
          <h2 class="font-display text-2xl mb-6">Preguntas frecuentes</h2>
          
          <div class="space-y-4">
            <details class="group">
              <summary class="cursor-pointer font-medium py-2 flex justify-between items-center">
                ¿Cuánto tarda mi pedido?
                <svg class="w-5 h-5 text-primary-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-primary-600 pb-4">
                Los pedidos se procesan en 24-48h y el envío tarda entre 2-5 días laborables según tu ubicación.
              </p>
            </details>
            
            <details class="group border-t border-primary-100">
              <summary class="cursor-pointer font-medium py-2 flex justify-between items-center">
                ¿Puedo cambiar o devolver mi pedido?
                <svg class="w-5 h-5 text-primary-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-primary-600 pb-4">
                Sí, tienes 30 días desde la recepción para cambios o devoluciones. Las prendas deben estar sin usar y con etiquetas.
              </p>
            </details>
            
            <details class="group border-t border-primary-100">
              <summary class="cursor-pointer font-medium py-2 flex justify-between items-center">
                ¿Hacen envíos internacionales?
                <svg class="w-5 h-5 text-primary-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-primary-600 pb-4">
                Actualmente enviamos a toda España y países de la Unión Europea. Consulta los gastos de envío en el checkout.
              </p>
            </details>
            
            <details class="group border-t border-primary-100">
              <summary class="cursor-pointer font-medium py-2 flex justify-between items-center">
                ¿Cómo sé mi talla?
                <svg class="w-5 h-5 text-primary-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <p class="text-primary-600 pb-4">
                Cada producto tiene una guía de tallas específica. Si tienes dudas, escríbenos y te ayudamos a elegir la talla correcta.
              </p>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formMessage = document.getElementById('form-message');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    try {
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone') || null,
        subject: formData.get('subject'),
        orderNumber: formData.get('order_number') || null,
        message: formData.get('message')
      };

      // Deshabilitar botón
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Enviando...';
      }

      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok) {
        if (formMessage) {
          formMessage.textContent = '¡Mensaje enviado! Te responderemos pronto.';
          formMessage.className = 'not-hidden text-center py-3 px-4 text-green-600 bg-green-50 rounded-lg';
        }
        form.reset();
      } else {
        if (formMessage) {
          formMessage.textContent = result.error || 'Error al enviar el mensaje. Inténtalo de nuevo.';
          formMessage.className = 'not-hidden text-center py-3 px-4 text-red-600 bg-red-50 rounded-lg';
        }
      }
    } catch (error: any) {
      if (formMessage) {
        formMessage.textContent = 'Error de conexión. Por favor, intenta más tarde.';
        formMessage.className = 'not-hidden text-center py-3 px-4 text-red-600 bg-red-50 rounded-lg';
      }
      console.error('Contact form error:', error);
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'ENVIAR MENSAJE';
      }
    }
  });
</script>
