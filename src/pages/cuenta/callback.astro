---
/**
 * OAuth Callback Handler
 * Procesa el retorno de proveedores OAuth (Google, etc.)
 * y establece las cookies de sesión
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { supabase, supabaseAdmin } from '@lib/supabase';

export const prerender = false;

// Obtener código de autorización de la URL
const url = new URL(Astro.request.url);
const code = url.searchParams.get('code');
const error = url.searchParams.get('error');
const errorDescription = url.searchParams.get('error_description');

let sessionError = '';
let redirectUrl = '/cuenta';

if (error) {
  sessionError = errorDescription || error;
} else if (code) {
  try {
    // Intercambiar código por sesión
    const { data, error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);
    
    if (exchangeError) {
      sessionError = exchangeError.message;
    } else if (data.session) {
      // Guardar tokens en cookies
      Astro.cookies.set('sb-access-token', data.session.access_token, {
        path: '/',
        maxAge: 60 * 60 * 24 * 7, // 7 días
        sameSite: 'lax',
        secure: import.meta.env.PROD
      });
      
      Astro.cookies.set('sb-refresh-token', data.session.refresh_token, {
        path: '/',
        maxAge: 60 * 60 * 24 * 30, // 30 días
        sameSite: 'lax',
        secure: import.meta.env.PROD
      });

      // Verificar si es admin
      const isAdmin = data.user?.app_metadata?.role === 'admin' || 
                      data.user?.user_metadata?.role === 'admin';
      
      if (isAdmin) {
        redirectUrl = '/admin';
      } else {
        // Crear perfil de cliente si no existe
        const { data: existingCustomer } = await supabaseAdmin
          .from('customers')
          .select('id')
          .eq('auth_user_id', data.user.id)
          .single();

        if (!existingCustomer) {
          await supabaseAdmin
            .from('customers')
            .insert({
              auth_user_id: data.user.id,
              email: data.user.email,
              first_name: data.user.user_metadata?.full_name?.split(' ')[0] || 
                         data.user.user_metadata?.name?.split(' ')[0] || 
                         'Cliente',
              last_name: data.user.user_metadata?.full_name?.split(' ').slice(1).join(' ') || '',
            });
        }

        // Verificar si hay un redirect guardado
        const savedRedirect = url.searchParams.get('redirect');
        redirectUrl = savedRedirect || '/cuenta';
      }

      // Redirigir inmediatamente
      return Astro.redirect(redirectUrl);
    }
  } catch (err: any) {
    sessionError = err.message || 'Error al procesar la autenticación';
  }
}
---

<BaseLayout title="Procesando autenticación...">
  <div class="min-h-screen flex items-center justify-center bg-primary-50">
    <div class="bg-white p-8 rounded-lg shadow-lg max-w-md w-full text-center">
      {sessionError ? (
        <div class="space-y-4">
          <div class="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h1 class="text-xl font-medium text-red-800">Error de autenticación</h1>
          <p class="text-red-600">{sessionError}</p>
          <a 
            href="/cuenta/login" 
            class="inline-block mt-4 px-6 py-2 bg-primary-900 text-white rounded hover:bg-primary-800"
          >
            Intentar de nuevo
          </a>
        </div>
      ) : (
        <div class="space-y-4">
          <div class="w-16 h-16 mx-auto">
            <svg class="animate-spin text-primary-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <h1 class="text-xl font-medium">Procesando...</h1>
          <p class="text-primary-600">Por favor espera mientras completamos tu inicio de sesión.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { mergeCartOnLogin } from '@stores/cart';
  import { supabase } from '@lib/supabase';

  // Manejar implicit flow: token llega en el hash fragment (#access_token=...)
  (async () => {
    try {
      const hash = window.location.hash;
      
      // Si hay hash con access_token, Supabase JS lo detecta automáticamente
      if (hash && hash.includes('access_token')) {
        // Parsear tokens del hash manualmente por si getSession no los pilla
        const params = new URLSearchParams(hash.substring(1));
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');
        
        if (accessToken && refreshToken) {
          // Establecer sesión manualmente con los tokens del hash
          const { data: { session }, error } = await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken
          });
          
          if (error) {
            console.error('Error setting session:', error);
            window.location.href = '/cuenta/login?error=session';
            return;
          }
          
          if (session?.user) {
            // Guardar cookies para SSR
            document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${60 * 60 * 24 * 7}; SameSite=Lax`;
            document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${60 * 60 * 24 * 30}; SameSite=Lax`;
            
            // Crear perfil de cliente si no existe (via API)
            try {
              const fullName = session.user.user_metadata?.full_name || session.user.user_metadata?.name || '';
              const nameParts = fullName.split(' ');
              await fetch('/api/auth/ensure-customer', {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  userId: session.user.id,
                  email: session.user.email,
                  firstName: nameParts[0] || 'Cliente',
                  lastName: nameParts.slice(1).join(' ') || '',
                })
              });
            } catch (e) {
              // No bloquear el login si falla crear el perfil
              console.warn('Could not ensure customer profile:', e);
            }
            
            // Merge carrito de invitado
            await mergeCartOnLogin(session.user.id);
            
            // Redirigir a cuenta
            const searchParams = new URLSearchParams(window.location.search);
            const redirect = searchParams.get('redirect') || '/cuenta';
            window.location.href = redirect;
            return;
          }
        }
      }
      
      // Fallback: Si hay code en query (PKCE) o no hay hash, intentar getSession
      const hasError = document.querySelector('.text-red-800');
      if (!hasError) {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user?.id) {
          document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${60 * 60 * 24 * 7}; SameSite=Lax`;
          document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=${60 * 60 * 24 * 30}; SameSite=Lax`;
          await mergeCartOnLogin(session.user.id);
          window.location.href = '/cuenta';
        } else {
          // Sin sesión y sin error visible — redirigir a login
          window.location.href = '/cuenta/login';
        }
      }
    } catch (err) {
      console.error('Error in OAuth callback:', err);
      window.location.href = '/cuenta/login?error=callback';
    }
  })();
</script>
