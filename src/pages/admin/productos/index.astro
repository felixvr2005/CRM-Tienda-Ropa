---
/**
 * Admin Products List - SSR
 */
import AdminLayout from '@layouts/AdminLayout.astro';
import { supabaseAdmin } from '@lib/supabase';
import { formatPrice } from '@lib/utils';

export const prerender = false;

const { data: products } = await supabaseAdmin
  .from('products')
  .select(`
    *,
    category:categories(id, name)
  `)
  .order('created_at', { ascending: false });

// Obtener categorías para el filtro
const { data: categories } = await supabaseAdmin
  .from('categories')
  .select('id, name')
  .order('name');
---

<AdminLayout title="Productos">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-display">Productos</h1>
        <p class="text-primary-500">{products?.length || 0} productos</p>
      </div>
      <a 
        href="/admin/productos/nuevo"
        class="flex items-center gap-2 bg-primary-900 text-white px-4 py-2 text-sm hover:bg-primary-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nuevo producto
      </a>
    </div>
    
    <!-- Search & Filters -->
    <div class="bg-white border border-primary-200 p-4 flex flex-wrap gap-4">
      <input 
        type="text"
        id="searchInput"
        placeholder="Buscar productos..."
        class="flex-1 min-w-[200px] border border-primary-300 px-4 py-2 text-sm focus:outline-none focus:border-primary-900"
      />
      <select id="categoryFilter" class="border border-primary-300 px-4 py-2 text-sm focus:outline-none focus:border-primary-900">
        <option value="">Todas las categorías</option>
        {categories?.map((cat) => (
          <option value={cat.id}>{cat.name}</option>
        ))}
      </select>
      <select id="statusFilter" class="border border-primary-300 px-4 py-2 text-sm focus:outline-none focus:border-primary-900">
        <option value="">Todos los estados</option>
        <option value="active">Activos</option>
        <option value="inactive">Inactivos</option>
        <option value="featured">Destacados</option>
        <option value="sale">En oferta</option>
      </select>
    </div>
    
    <!-- Products Table -->
    <div class="bg-white border border-primary-200 overflow-hidden">
      <table class="w-full">
        <thead class="bg-primary-50">
          <tr>
            <th class="text-left text-xs uppercase tracking-wider text-primary-500 px-4 py-3">Producto</th>
            <th class="text-left text-xs uppercase tracking-wider text-primary-500 px-4 py-3">Categoría</th>
            <th class="text-left text-xs uppercase tracking-wider text-primary-500 px-4 py-3">Precio</th>
            <th class="text-left text-xs uppercase tracking-wider text-primary-500 px-4 py-3">Estado</th>
            <th class="text-left text-xs uppercase tracking-wider text-primary-500 px-4 py-3">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary-100">
          {products && products.length > 0 ? (
            products.map((product) => (
              <tr 
                class="product-row hover:bg-primary-50 transition-colors"
                data-name={product.name.toLowerCase()}
                data-sku={(product.sku || '').toLowerCase()}
                data-category-id={product.category?.id || ''}
                data-is-active={product.is_active ? 'true' : 'false'}
                data-is-featured={product.is_featured ? 'true' : 'false'}
                data-has-discount={product.discount_percentage > 0 ? 'true' : 'false'}
              >
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-primary-100 flex-shrink-0 overflow-hidden">
                      {product.images && product.images.length > 0 ? (
                        <img 
                          src={product.images[0]} 
                          alt={product.name}
                          class="w-full h-full object-cover"
                        />
                      ) : (
                        <div class="w-full h-full bg-primary-200"></div>
                      )}
                    </div>
                    <div>
                      <p class="font-medium">{product.name}</p>
                      <p class="text-xs text-primary-500">SKU: {product.sku || 'N/A'}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm text-primary-600">
                  {product.category?.name || '-'}
                </td>
                <td class="px-4 py-3">
                  <div>
                    {product.discount_percentage > 0 ? (
                      <>
                        <span class="text-red-600 font-medium">
                          {formatPrice(product.price / 100 * (1 - product.discount_percentage / 100))}
                        </span>
                        <span class="text-xs text-primary-400 line-through ml-2">
                          {formatPrice(product.price / 100)}
                        </span>
                      </>
                    ) : (
                      <span class="font-medium">{formatPrice(product.price / 100)}</span>
                    )}
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex gap-2">
                    {product.is_featured && (
                      <span class="text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded">Destacado</span>
                    )}
                    {product.is_new && (
                      <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Nuevo</span>
                    )}
                    {product.discount_percentage > 0 && (
                      <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded">-{product.discount_percentage}%</span>
                    )}
                    {!product.is_active && (
                      <span class="text-xs bg-primary-100 text-primary-700 px-2 py-0.5 rounded">Inactivo</span>
                    )}
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <a 
                      href={`/admin/productos/${product.id}`}
                      class="text-sm text-primary-600 hover:text-primary-900"
                    >
                      Editar
                    </a>
                    <button 
                      class="text-sm text-red-600 hover:text-red-800"
                      data-product-id={product.id}
                      onclick="deleteProduct(this)"
                    >
                      Eliminar
                    </button>
                  </div>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="5" class="px-4 py-8 text-center text-primary-500">
                No hay productos. <a href="/admin/productos/nuevo" class="underline hover:text-primary-900">Crear el primero</a>
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>
  
  <script is:inline>
    // ── Filtros de productos ──
    const searchInput = document.getElementById('searchInput');
    const categoryFilter = document.getElementById('categoryFilter');
    const statusFilter = document.getElementById('statusFilter');
    const productRows = document.querySelectorAll('.product-row');

    function applyFilters() {
      const searchTerm = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categoryFilter?.value || '';
      const selectedStatus = statusFilter?.value || '';

      productRows.forEach(row => {
        const name = row.dataset.name || '';
        const sku = row.dataset.sku || '';
        const categoryId = row.dataset.categoryId || '';
        const isActive = row.dataset.isActive === 'true';
        const isFeatured = row.dataset.isFeatured === 'true';
        const hasDiscount = row.dataset.hasDiscount === 'true';

        let visible = true;

        // Filtro de búsqueda
        if (searchTerm && !name.includes(searchTerm) && !sku.includes(searchTerm)) {
          visible = false;
        }

        // Filtro de categoría
        if (selectedCategory && categoryId !== selectedCategory) {
          visible = false;
        }

        // Filtro de estado
        if (selectedStatus) {
          if (selectedStatus === 'active' && !isActive) visible = false;
          if (selectedStatus === 'inactive' && isActive) visible = false;
          if (selectedStatus === 'featured' && !isFeatured) visible = false;
          if (selectedStatus === 'sale' && !hasDiscount) visible = false;
        }

        row.style.display = visible ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', applyFilters);
    categoryFilter?.addEventListener('change', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);

    // ── Eliminar producto ──
    async function deleteProduct(button) {
      if (!confirm('¿Estás seguro de eliminar este producto?')) return;
      
      const productId = button.dataset.productId;
      
      try {
        const response = await fetch(`/api/admin/products/${productId}`, {
          method: 'DELETE',
        });
        
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Error al eliminar el producto');
        }
      } catch (error) {
        alert('Error al eliminar el producto');
      }
    }
  </script>
</AdminLayout>
